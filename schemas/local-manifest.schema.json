{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-manifest.schema.json",
  "title": "Local-only localization manifest",
  "description": "Extends an inventory with replacement payloads. This file must never be committed to the public kit repository.",
  "type": "object",
  "required": [
    "schemaVersion",
    "inventory",
    "package",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "inventory": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "upstreamSha256",
          "localizedSha256",
          "stringCount",
          "replacements"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "upstreamSha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "localizedSha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "stringCount": {
            "type": "integer",
            "minimum": 0
          },
          "replacements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "from",
                "to",
                "expectedCount"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "expectedCount": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
