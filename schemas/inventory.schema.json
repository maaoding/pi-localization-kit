{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "Localization inventory",
  "type": "object",
  "required": [
    "schemaVersion",
    "package",
    "source",
    "scope",
    "keepEnglish",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "version",
        "installPath"
      ],
      "properties": {
        "kind": {
          "enum": [
            "core",
            "extension"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^d+.d+.d+(?:-[0-9A-Za-z.-]+)?(?:+[0-9A-Za-z.-]+)?$"
        },
        "installPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "tarball",
        "integrity",
        "shasum"
      ],
      "properties": {
        "tarball": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "shasum": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "keepEnglish": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "upstreamSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "upstreamSha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "stringCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
